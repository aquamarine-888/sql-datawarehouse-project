-- =============================================================================
-- CRM TABLES: CLEANING & TYPE CONVERSION
-- =============================================================================

-- Table: crm_cust_info (Total: 18,493 rows)
-- ------------------------------------------------------------------------------
SELECT COUNT(*)FROM crm_cust_info;

-- 1. Convert all empty strings to NULL (rows with space excluded)
UPDATE crm_cust_info
SET
	cst_id = NULLIF(cst_id, ''),
    cst_firstname = NULLIF(cst_firstname, ''),
	cst_lastname = NULLIF(cst_lastname, ''),
    cst_marital_status = NULLIF(cst_marital_status, ''),
    cst_gndr = NULLIF(cst_gndr, ''),
    cst_create_date = NULLIF(cst_create_date, '');

-- 2. Format Dates (Slash to Dash)
UPDATE crm_cust_info
SET
	cst_create_date = str_to_date(cst_create_date, '%Y/%m/%d')
WHERE cst_create_date IS NOT NULL;

-- 3. Finalize Data Types
ALTER TABLE crm_cust_info
MODIFY COLUMN cst_id INT,
MODIFY COLUMN cst_create_date DATE;

-- testing
SELECT *
FROM crm_cust_info
WHERE cst_id 
ORDER BY cst_create_date DESC;


-- Table: crm_prd_info (Total: 397 rows)
-- ------------------------------------------------------------------------------
SELECT * FROM crm_prd_info;
SELECT COUNT(*) FROM crm_prd_info;

-- 1. Convert all empty strings to NULL (rows with space excluded)
UPDATE crm_prd_info
SET
	prd_cost = NULLIF(prd_cost, ''),
    prd_line = NULLIF(prd_line, ''),
    prd_end_dt = NULLIF(prd_end_dt, '');

-- 2. Format Dates
UPDATE crm_prd_info
SET
	prd_start_dt = str_to_date(prd_start_dt, '%Y/%m/%d'),
    prd_end_dt = str_to_date(prd_end_dt, '%Y/%m/%d')
WHERE prd_end_dt IS NOT NULL;

-- 3. Finalize Data Types
ALTER TABLE crm_prd_info
MODIFY COLUMN prd_cost DECIMAL (10,2),
MODIFY COLUMN prd_start_dt DATE,
MODIFY COLUMN prd_end_dt DATE;

-- Testing
SELECT 
    prd_id,
    prd_nm, 
    prd_end_dt, 
    prd_cost,
    (prd_cost * 1.05) AS price_plus_tax -- Testing the math
FROM crm_prd_info 
ORDER BY prd_end_dt DESC; -- Testing the date sorting;


-- Table: crm_sales_details
-- ------------------------------------------------------------------------------
SELECT * FROM crm_sales_details;
SELECT COUNT(*) FROM crm_sales_details;

Update crm_sales_details
SET 
	sls_cust_id = NULLIF(sls_cust_id, ''),
    sls_order_dt = NULLIF(sls_order_dt, ''),
    sls_ship_dt = NULLIF(sls_ship_dt, ''),
    sls_due_dt = NULLIF(sls_due_dt, ''),
    sls_sales = NULLIF(sls_sales, ''),	
    sls_quantity = NULLIF(sls_quantity, ''),
    sls_price = NULLIF(sls_price, '');

ALTER TABLE crm_sales_details
MODIFY COLUMN sls_cust_id INT,
MODIFY COLUMN sls_order_dt INT,
MODIFY COLUMN sls_ship_dt INT,
MODIFY COLUMN sls_due_dt INT,
MODIFY COLUMN sls_sales INT,
MODIFY COLUMN sls_quantity INT,
MODIFY COLUMN sls_price INT;

SELECT
	sls_cust_id,
    sls_order_dt,
    sls_sales
FROM crm_sales_details
WHERE sls_price IS NULL;


