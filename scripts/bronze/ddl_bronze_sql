-- Table: crm_cust_info
-- Note: cst_id is VARCHAR because 3 rows have missing IDs which would crash an INT column.
/* 
DROP TABLE IF EXISTS crm_cust_info;
CREATE TABLE crm_cust_info (
	cst_id 				INT,
    cst_key 			VARCHAR(50),
    cst_firstname 		VARCHAR(50),
    cst_lastname 		VARCHAR(50),
    cst_marital_status 	VARCHAR(50),
    cst_gndr 			VARCHAR(50),
    cst_create_date 	DATE
    );
*/

DROP TABLE IF EXISTS crm_cust_info;
CREATE TABLE crm_cust_info (
	cst_id 				VARCHAR(50),
    cst_key 			VARCHAR(50),
    cst_firstname 		VARCHAR(50),
    cst_lastname 		VARCHAR(50),
    cst_marital_status 	VARCHAR(50),
    cst_gndr 			VARCHAR(50),
    cst_create_date 	VARCHAR(50)
    );



-- Table: crm_prd_info
-- Note: prd_cost and dates are VARCHAR to handle empty strings and slash delimiters.
/*
CREATE TABLE crm_prd_info (
	prd_id 			INT,
    prd_key 		VARCHAR(50),
    prd_nm			VARCHAR(50),
    prd_cost 		DECIMAL(10, 2) NULL,
    prd_line 		VARCHAR(50),
    prd_start_dt 	DATE, 
    prd_end_dt 		VARCHAR(50) -- coz is last column, Table import wizard wont import all info, so use VARCHAR first
    );
*/

DROP TABLE IF EXISTS crm_prd_info;
CREATE TABLE crm_prd_info (
	prd_id 			INT,
    prd_key 		VARCHAR(50),
    prd_nm			VARCHAR(50),
    prd_cost 		VARCHAR(50),
    prd_line 		VARCHAR(50),
    prd_start_dt 	VARCHAR(50), 
    prd_end_dt 		VARCHAR(50) 
    );


